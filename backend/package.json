{
  "name": "@clinic/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc-watch --onSuccess \"node dist/src/main.js\"",
    "start": "node dist/src/main.js",
    "db:migrate": "npm run build && node dist/scripts/migrate.js",
    "db:seed": "npm run build && node dist/scripts/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "dotenv": "^17.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "supertest": "^7.1.0",
    "tsc-watch": "^7.0.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.7"
  }
}
