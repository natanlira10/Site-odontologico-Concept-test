{
  "name": "dental-clinic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend-client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:spa && npm run build --workspaces",
    "build:spa": "vue-tsc && vite build",
    "preview": "vite preview",
    "backend:dev": "npm run dev -w backend",
    "backend:build": "npm run build -w backend",
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:local": "node scripts/local-db.mjs",
    "db:cleanup": "node backend/dist/scripts/cleanup.js",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "start": "npm run start -w backend",
    "lint": "oxlint --deny-warnings backend/src backend/scripts backend/test frontend-client/src src/services/api.ts src/services/admin-api.ts src/composables/useBooking.ts src/composables/useAdminDashboard.ts",
    "test": "npm run test -w backend",
    "check": "npm run build && npm run lint && npm test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.475.0",
    "tailwind-merge": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "oxlint": "^1.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
